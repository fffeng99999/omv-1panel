msgstr ""

msgid "Settings"
msgstr ""

msgid "Updated 1Panel settings."
msgstr ""

msgid "Running"
msgstr ""

msgid "Stopped"
msgstr ""

msgid "Partial"
msgstr ""

msgid "Not installed"
msgstr ""

msgid "1Panel is a Linux server management panel. The settings below are used by the Install button, which downloads the official upstream release from the 1Panel CDN and runs the official installer non-interactively. Save the settings first, then use the buttons below to install and manage the panel. The panel itself (app store, websites, databases) is managed in the native 1Panel interface."
msgstr ""

msgid "Status"
msgstr ""

msgid "Service status"
msgstr ""

