# any later version.

set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

case "$1" in
	purge)
		echo "Cleaning up configuration database ..."
		omv_config_delete "/config/services/onepanel"
		# Activate trigger to rebuild workbench configuration files.
		dpkg-trigger update-workbench
		# The 1Panel installation itself is never uninstalled here; use
		# the Uninstall button in the web interface for that (the panel
		# data directory is kept).
	;;

	remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
		# Activate trigger to rebuild workbench configuration files.
		dpkg-trigger update-workbench
	;;

	*)
		echo "postrm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0
