#!/usr/bin/make -f

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

%:
	dh $@

# Windows checkouts do not preserve the executable bit; force the
# correct modes on the shipped scripts before packaging.
execute_before_dh_installdeb:
	chmod 0755 debian/openmediavault-1panel.postinst
	chmod 0755 debian/openmediavault-1panel.prerm
	chmod 0755 debian/openmediavault-1panel.postrm
	chmod 0755 debian/openmediavault-1panel/usr/sbin/omv-1panel-ctl || true
	chmod 0755 debian/openmediavault-1panel/usr/share/openmediavault/confdb/create.d/*.sh
