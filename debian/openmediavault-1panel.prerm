set -e

case "$1" in
	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear|remove|purge)
		# The 1Panel installation (binaries, systemd units, panel data
		# directory) is intentionally never touched here. Removing the
		# plugin leaves the panel installed and running.
	;;

	*)
		echo "prerm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

exit 0
